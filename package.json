    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
